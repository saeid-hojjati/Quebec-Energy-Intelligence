              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.StageRowID,
    s.DateText,
    s.TotalMWText,

    TRY_CONVERT(
        DECIMAL(20,4),
        NULLIF(TRIM(s.HydroelectricMWText), '')
    ) AS HydroelectricMW,

    TRY_CONVERT(
        DECIMAL(20,4),
        NULLIF(TRIM(s.WindMWText), '')
    ) AS WindMW,

    TRY_CONVERT(
        DECIMAL(20,4),
        NULLIF(TRIM(s.OtherRenewablesMWText), '')
    ) AS OtherRenewablesMW,

    TRY_CONVERT(
        DECIMAL(20,4),
        NULLIF(TRIM(s.SolarMWText), '')
    ) AS SolarMW,

    TRY_CONVERT(
        DECIMAL(20,4),
        NULLIF(TRIM(s.ThermalMWText), '')
    ) AS ThermalMW,

    TRY_CONVERT(
        DECIMAL(20,4),
        NULLIF(TRIM(s.TotalMWText), '')
    ) AS TotalMW,

    CAST(
        TRY_CONVERT(
            DATETIMEOFFSET(0),
            NULLIF(TRIM(s.DateText), '')
        ) AS DATETIME2(0)
    ) AS LocalHour,

    CAST(
        SWITCHOFFSET(
            TRY_CONVERT(
                DATETIMEOFFSET(0),
                NULLIF(TRIM(s.DateText), '')
            ),
            '+00:00'
        ) AS DATETIME2(0)
    ) AS HourUTC

FROM stg.GenerationRaw AS s;</property>
