    <DTS:Executable
      DTS:refId="Package\SQL_Clear_CleanOutputs"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{41C36A44-BF98-4F2B-BF46-43457EFEA939}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Clear_CleanOutputs"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;-- Clear previous Data Quality logs&#xA;DELETE FROM etl.DataQualityIssue&#xA;WHERE DatasetName IN (N'Demand', N'Generation');&#xA;&#xA;-- Clear previous cleaned Demand data&#xA;DELETE FROM wrk.DemandClean;&#xA;&#xA;-- Clear previous cleaned Generation data&#xA;DELETE FROM wrk.GenerationClean;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Log_Duplicate_Timestamps"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{052A6CA0-81EE-47B6-A225-E0ED14F314E1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Log_Duplicate_Timestamps"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;-- Remove only previous duplicate logs&#xA;DELETE FROM etl.DataQualityIssue&#xA;WHERE IssueCode = N'DUPLICATE_UTC_TIMESTAMP'&#xA;  AND DatasetName IN (N'Demand', N'Generation');&#xA;&#xA;-- Identify duplicate UTC timestamps&#xA;;WITH AllRecords AS (&#xA;    SELECT&#xA;        N'Demand' AS DatasetName,&#xA;        c.StageRowID,&#xA;        r.DateText,&#xA;        r.DemandMWText AS RawValueText,&#xA;        c.HourUTC&#xA;    FROM wrk.DemandClean c&#xA;    JOIN stg.DemandRaw r&#xA;        ON c.StageRowID = r.StageRowID&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT&#xA;        N'Generation',&#xA;        c.StageRowID,&#xA;        r.DateText,&#xA;        r.TotalMWText,&#xA;        c.HourUTC&#xA;    FROM wrk.GenerationClean c&#xA;    JOIN stg.GenerationRaw r&#xA;        ON c.StageRowID = r.StageRowID&#xA;),&#xA;Duplicates AS (&#xA;    SELECT *,&#xA;        COUNT(*) OVER (&#xA;            PARTITION BY DatasetName, HourUTC&#xA;        ) AS DuplicateCount&#xA;    FROM AllRecords&#xA;)&#xA;INSERT INTO etl.DataQualityIssue (&#xA;    DatasetName,&#xA;    StageRowID,&#xA;    RawDateText,&#xA;    RawValueText,&#xA;    IssueCode&#xA;)&#xA;SELECT&#xA;    DatasetName,&#xA;    StageRowID,&#xA;    DateText,&#xA;    RawValueText,&#xA;    N'DUPLICATE_UTC_TIMESTAMP'&#xA;FROM Duplicates&#xA;WHERE DuplicateCount &gt; 1;&#xA;&#xA;COMMIT TRANSACTION;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Log_Negative_Generation"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{669CEDE9-F94B-4629-9173-1B78DD2DCB6D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Log_Negative_Generation"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;-- Remove previous negative-value warnings&#xA;DELETE FROM etl.DataQualityIssue&#xA;WHERE DatasetName = N'Generation'&#xA;  AND IssueCode IN (&#xA;      N'NEGATIVE_WIND_MW',&#xA;      N'NEGATIVE_SOLAR_MW'&#xA;  );&#xA;&#xA;-- Record negative Wind values&#xA;INSERT INTO etl.DataQualityIssue (&#xA;    DatasetName,&#xA;    StageRowID,&#xA;    RawDateText,&#xA;    RawValueText,&#xA;    IssueCode&#xA;)&#xA;SELECT&#xA;    N'Generation',&#xA;    g.StageRowID,&#xA;    r.DateText,&#xA;    r.WindMWText,&#xA;    N'NEGATIVE_WIND_MW'&#xA;FROM wrk.GenerationClean AS g&#xA;JOIN stg.GenerationRaw AS r&#xA;    ON g.StageRowID = r.StageRowID&#xA;WHERE g.WindMW &lt; 0;&#xA;&#xA;-- Record negative Solar values&#xA;INSERT INTO etl.DataQualityIssue (&#xA;    DatasetName,&#xA;    StageRowID,&#xA;    RawDateText,&#xA;    RawValueText,&#xA;    IssueCode&#xA;)&#xA;SELECT&#xA;    N'Generation',&#xA;    g.StageRowID,&#xA;    r.DateText,&#xA;    r.SolarMWText,&#xA;    N'NEGATIVE_SOLAR_MW'&#xA;FROM wrk.GenerationClean AS g&#xA;JOIN stg.GenerationRaw AS r&#xA;    ON g.StageRowID = r.StageRowID&#xA;WHERE g.SolarMW &lt; 0;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Validate_Clean_Data"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A90C31FE-AD7B-4E2B-8D77-685BE2EC1EC6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Validate_Clean_Data"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;USE QuebecEnergyBI;&#xA;&#xA;SET NOCOUNT ON;&#xA;&#xA;-- ==========================================&#xA;-- 1. Declare variables&#xA;-- ==========================================&#xA;&#xA;DECLARE @RawDemand BIGINT;&#xA;DECLARE @CleanDemand BIGINT;&#xA;DECLARE @InvalidDemand BIGINT;&#xA;&#xA;DECLARE @RawGeneration BIGINT;&#xA;DECLARE @CleanGeneration BIGINT;&#xA;DECLARE @InvalidGeneration BIGINT;&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 2. Demand row counts&#xA;-- ==========================================&#xA;&#xA;SELECT @RawDemand = COUNT_BIG(*)&#xA;FROM stg.DemandRaw;&#xA;&#xA;SELECT @CleanDemand = COUNT_BIG(*)&#xA;FROM wrk.DemandClean;&#xA;&#xA;SELECT @InvalidDemand = COUNT_BIG(*)&#xA;FROM etl.DataQualityIssue&#xA;WHERE DatasetName = N'Demand'&#xA;  AND IssueCode = N'INVALID_DEMAND_ROW';&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 3. Generation row counts&#xA;-- ==========================================&#xA;&#xA;SELECT @RawGeneration = COUNT_BIG(*)&#xA;FROM stg.GenerationRaw;&#xA;&#xA;SELECT @CleanGeneration = COUNT_BIG(*)&#xA;FROM wrk.GenerationClean;&#xA;&#xA;SELECT @InvalidGeneration = COUNT_BIG(*)&#xA;FROM etl.DataQualityIssue&#xA;WHERE DatasetName = N'Generation'&#xA;  AND IssueCode = N'INVALID_GENERATION_ROW';&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 4. Validate non-empty source datasets&#xA;-- ==========================================&#xA;&#xA;IF @RawDemand = 0&#xA;    THROW 51000, 'Demand source is empty.', 1;&#xA;&#xA;IF @RawGeneration = 0&#xA;    THROW 51001, 'Generation source is empty.', 1;&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 5. Validate Demand&#xA;-- ==========================================&#xA;&#xA;IF @RawDemand &lt;&gt; (@CleanDemand + @InvalidDemand)&#xA;BEGIN&#xA;    THROW 51002,&#xA;        'Demand row count mismatch.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 6. Validate Generation&#xA;-- ==========================================&#xA;&#xA;IF @RawGeneration &lt;&gt; (@CleanGeneration + @InvalidGeneration)&#xA;BEGIN&#xA;    THROW 51003,&#xA;        'Generation row count mismatch.',&#xA;        1;&#xA;END;&#xA;&#xA;&#xA;-- ==========================================&#xA;-- 7. Validation completed successfully&#xA;-- ==========================================&#xA;&#xA;PRINT 'Data validation completed successfully.';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
