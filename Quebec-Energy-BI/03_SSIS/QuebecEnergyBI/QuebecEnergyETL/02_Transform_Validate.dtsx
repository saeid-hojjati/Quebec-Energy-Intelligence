                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.StageRowID,
    s.DateText,
    s.DemandMWText,

    p.DemandMW,

    CAST(
        p.ParsedDate AS DATETIME2(0)
    ) AS LocalHour,

    CAST(
        SWITCHOFFSET(p.ParsedDate, '+00:00')
        AS DATETIME2(0)
    ) AS HourUTC

FROM stg.DemandRaw AS s

CROSS APPLY (
    SELECT
        TRY_CONVERT(
            DATETIMEOFFSET(0),
            NULLIF(TRIM(s.DateText), '')
        ) AS ParsedDate,

        TRY_CONVERT(
            DECIMAL(20,4),
            NULLIF(TRIM(s.DemandMWText), '')
        ) AS DemandMW
) AS p;</property>
