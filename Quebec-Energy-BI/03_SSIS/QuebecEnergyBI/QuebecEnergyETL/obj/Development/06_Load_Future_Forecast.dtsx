    <DTS:Executable
      DTS:refId="Package\SQL_Clear_Forecast_Stage"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{28E7DB2A-59B1-48B9-B8CE-11DA2C54C3B9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Clear_Forecast_Stage"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;TRUNCATE TABLE stg.OperationalForecastLoad;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Publish_Future_Forecast"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F637244A-2C4E-4649-B7E3-DCE8BC2D2BDA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Publish_Future_Forecast"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET XACT_ABORT ON;&#xA;&#xA;DECLARE @Origin DATETIME2(0);&#xA;DECLARE @Model NVARCHAR(100);&#xA;DECLARE @ExpectedRows INT;&#xA;DECLARE @ActualRows INT;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- 1. Check staging rows&#xA;    SELECT @ActualRows = COUNT(*)&#xA;    FROM stg.OperationalForecastLoad;&#xA;&#xA;    IF @ActualRows = 0&#xA;        THROW 51010, 'Forecast staging table is empty.', 1;&#xA;&#xA;    -- 2. Require one model and one forecast origin&#xA;    IF (&#xA;        SELECT COUNT(DISTINCT Model)&#xA;        FROM stg.OperationalForecastLoad&#xA;    ) &lt;&gt; 1&#xA;        THROW 51011, 'Multiple models detected.', 1;&#xA;&#xA;    IF (&#xA;        SELECT COUNT(DISTINCT ForecastOriginUTC)&#xA;        FROM stg.OperationalForecastLoad&#xA;    ) &lt;&gt; 1&#xA;        THROW 51012, 'Multiple forecast origins detected.', 1;&#xA;&#xA;    SELECT TOP (1)&#xA;        @Origin = ForecastOriginUTC,&#xA;        @Model = Model&#xA;    FROM stg.OperationalForecastLoad;&#xA;&#xA;    -- 3. Determine expected row count&#xA;    SET @ExpectedRows =&#xA;        CASE&#xA;            WHEN @Model = N'Weekly Gradient Boosting'&#xA;                THEN 168&#xA;            WHEN @Model = N'Biweekly Gradient Boosting'&#xA;                THEN 336&#xA;            ELSE NULL&#xA;        END;&#xA;&#xA;    IF @ExpectedRows IS NULL&#xA;        THROW 51013, 'Unknown forecast model.', 1;&#xA;&#xA;    IF @ActualRows &lt;&gt; @ExpectedRows&#xA;        THROW 51014, 'Unexpected forecast row count.', 1;&#xA;&#xA;    -- 4. Check for duplicate horizon hours&#xA;    IF EXISTS (&#xA;        SELECT HorizonHours&#xA;        FROM stg.OperationalForecastLoad&#xA;        GROUP BY HorizonHours&#xA;        HAVING COUNT(*) &gt; 1&#xA;    )&#xA;        THROW 51015, 'Duplicate horizon hours.', 1;&#xA;&#xA;    -- 5. Validate dates, horizons and values&#xA;    IF EXISTS (&#xA;        SELECT 1&#xA;        FROM stg.OperationalForecastLoad&#xA;        WHERE HorizonHours NOT BETWEEN 1 AND @ExpectedRows&#xA;           OR DATEADD(&#xA;                HOUR, HorizonHours, ForecastOriginUTC&#xA;              ) &lt;&gt; HourUTC&#xA;           OR PredictedDemandMW &lt; 0&#xA;    )&#xA;        THROW 51016, 'Invalid forecast data.', 1;&#xA;&#xA;    -- 6. Ensure complete forecast sequence&#xA;    IF (&#xA;        SELECT MIN(HorizonHours)&#xA;        FROM stg.OperationalForecastLoad&#xA;    ) &lt;&gt; 1&#xA;    OR (&#xA;        SELECT MAX(HorizonHours)&#xA;        FROM stg.OperationalForecastLoad&#xA;    ) &lt;&gt; @ExpectedRows&#xA;        THROW 51017, 'Incomplete forecast horizon.', 1;&#xA;&#xA;    -- 7. Replace only this model and forecast origin&#xA;    DELETE FROM ml.OperationalForecast&#xA;    WHERE ForecastOriginUTC = @Origin&#xA;      AND Model = @Model;&#xA;&#xA;    -- 8. Insert validated forecast&#xA;    INSERT INTO ml.OperationalForecast&#xA;    (&#xA;        ForecastOriginUTC,&#xA;        HourUTC,&#xA;        HorizonHours,&#xA;        PredictedDemandMW,&#xA;        Model&#xA;    )&#xA;    SELECT&#xA;        ForecastOriginUTC,&#xA;        HourUTC,&#xA;        HorizonHours,&#xA;        PredictedDemandMW,&#xA;        Model&#xA;    FROM stg.OperationalForecastLoad;&#xA;&#xA;    -- 9. Final validation&#xA;    IF (&#xA;        SELECT COUNT(*)&#xA;        FROM ml.OperationalForecast&#xA;        WHERE ForecastOriginUTC = @Origin&#xA;          AND Model = @Model&#xA;    ) &lt;&gt; @ExpectedRows&#xA;        THROW 51018, 'Final forecast load failed.', 1;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
