              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    s.StageRowID,
    s.HourUTCText,
    s.TemperatureCText,
    s.HumidityPercentText,
    s.PrecipitationMMText,

    p.HourUTC,

    CAST(
        p.HourUTC AT TIME ZONE 'UTC'
        AT TIME ZONE 'Eastern Standard Time'
        AS DATETIME2(0)
    ) AS LocalHour,

    TRY_CONVERT(
        DECIMAL(9,3),
        NULLIF(TRIM(s.TemperatureCText), '')
    ) AS TemperatureC,

    TRY_CONVERT(
        DECIMAL(5,2),
        NULLIF(TRIM(s.HumidityPercentText), '')
    ) AS HumidityPercent,

    TRY_CONVERT(
        DECIMAL(12,3),
        NULLIF(TRIM(s.PrecipitationMMText), '')
    ) AS PrecipitationMM

FROM stg.WeatherRaw AS s

CROSS APPLY (
    SELECT
        NULLIF(TRIM(s.HourUTCText), '') AS CleanHour
) AS t

CROSS APPLY (
    SELECT
        CASE
            WHEN LEN(t.CleanHour) = 16
             AND SUBSTRING(t.CleanHour, 11, 1) = 'T'
            THEN t.CleanHour + ':00'
            ELSE t.CleanHour
        END AS NormalizedHour
) AS n

CROSS APPLY (
    SELECT
        TRY_CONVERT(
            DATETIME2(0),
            n.NormalizedHour,
            126
        ) AS HourUTC
) AS p;</property>
