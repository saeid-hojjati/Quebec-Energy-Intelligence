          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @ExpectedRows BIGINT;&#xA;DECLARE @ActualRows BIGINT;&#xA;&#xA;-- 1. Expected rows based on DimDate&#xA;SELECT @ExpectedRows = COUNT_BIG(*)&#xA;FROM wrk.WeatherClean AS w&#xA;INNER JOIN dw.DimDate AS d&#xA;    ON d.FullDate = CAST(w.LocalHour AS DATE);&#xA;&#xA;-- 2. Actual rows&#xA;SELECT @ActualRows = COUNT_BIG(*)&#xA;FROM dw.FactWeatherHourly;&#xA;&#xA;IF @ActualRows &lt;&gt; @ExpectedRows&#xA;    THROW 51030,&#xA;        'Weather Fact row count mismatch.',&#xA;        1;&#xA;&#xA;-- 3. Check duplicate UTC hours&#xA;IF EXISTS (&#xA;    SELECT HourUTC&#xA;    FROM dw.FactWeatherHourly&#xA;    GROUP BY HourUTC&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51031,&#xA;        'Duplicate Weather UTC hours.',&#xA;        1;&#xA;&#xA;-- 4. Check numerical values&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.FactWeatherHourly&#xA;    WHERE HumidityPercent NOT BETWEEN 0 AND 100&#xA;       OR PrecipitationMM &lt; 0&#xA;)&#xA;    THROW 51032,&#xA;        'Invalid Weather measurements.',&#xA;        1;&#xA;&#xA;-- 5. Check DateKey matches local date&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.FactWeatherHourly AS f&#xA;    INNER JOIN dw.DimDate AS d&#xA;        ON f.DateKey = d.DateKey&#xA;    WHERE d.FullDate &lt;&gt; CAST(f.LocalHour AS DATE)&#xA;)&#xA;    THROW 51033,&#xA;        'Weather DateKey mismatch.',&#xA;        1;&#xA;&#xA;-- 6. Verify Demand hours have Weather data&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.FactDemandHourly AS demand&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM dw.FactWeatherHourly AS weather&#xA;        WHERE weather.HourUTC = demand.HourUTC&#xA;    )&#xA;)&#xA;    THROW 51034,&#xA;        'Missing Weather data for Demand hours.',&#xA;        1;&#xA;&#xA;PRINT 'Weather Fact validation successful.';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Validate_Weather"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F42DB325-EE9E-4D20-B819-41D3E7C120AF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Validate_Weather"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @Raw BIGINT;&#xA;DECLARE @Clean BIGINT;&#xA;DECLARE @Invalid BIGINT;&#xA;&#xA;SELECT @Raw = COUNT_BIG(*)&#xA;FROM stg.WeatherRaw;&#xA;&#xA;SELECT @Clean = COUNT_BIG(*)&#xA;FROM wrk.WeatherClean;&#xA;&#xA;SELECT @Invalid = COUNT_BIG(*)&#xA;FROM etl.DataQualityIssue&#xA;WHERE DatasetName = N'Weather'&#xA;  AND IssueCode = N'INVALID_WEATHER_ROW';&#xA;&#xA;-- Check source&#xA;IF @Raw = 0&#xA;    THROW 51020, 'Weather source is empty.', 1;&#xA;&#xA;-- Check row counts&#xA;IF @Raw &lt;&gt; @Clean + @Invalid&#xA;    THROW 51021, 'Weather row count mismatch.', 1;&#xA;&#xA;-- Check duplicate UTC hours&#xA;IF EXISTS (&#xA;    SELECT HourUTC&#xA;    FROM wrk.WeatherClean&#xA;    GROUP BY HourUTC&#xA;    HAVING COUNT_BIG(*) &gt; 1&#xA;)&#xA;    THROW 51022, 'Duplicate Weather hours.', 1;&#xA;&#xA;-- Validate numerical ranges&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM wrk.WeatherClean&#xA;    WHERE HumidityPercent &lt; 0&#xA;       OR HumidityPercent &gt; 100&#xA;       OR PrecipitationMM &lt; 0&#xA;)&#xA;    THROW 51023, 'Invalid Weather values.', 1;&#xA;&#xA;PRINT 'Weather validation completed successfully.';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
