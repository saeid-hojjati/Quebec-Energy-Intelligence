      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;TRUNCATE TABLE dw.FactGenerationBySource;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_DimDate"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E2357258-E293-44DD-BB5D-1137555D2EC5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_DimDate"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;;WITH DateBounds AS (&#xA;    SELECT&#xA;        MIN(CAST(LocalHour AS DATE)) AS MinDate,&#xA;        MAX(CAST(LocalHour AS DATE)) AS MaxDate&#xA;    FROM (&#xA;        SELECT LocalHour&#xA;        FROM wrk.DemandClean&#xA;&#xA;        UNION ALL&#xA;&#xA;        SELECT LocalHour&#xA;        FROM wrk.GenerationClean&#xA;    ) AS DataDates&#xA;),&#xA;Calendar AS (&#xA;    SELECT&#xA;        MinDate AS FullDate,&#xA;        MaxDate&#xA;    FROM DateBounds&#xA;    WHERE MinDate IS NOT NULL&#xA;&#xA;    UNION ALL&#xA;&#xA;    SELECT&#xA;        DATEADD(DAY, 1, FullDate),&#xA;        MaxDate&#xA;    FROM Calendar&#xA;    WHERE FullDate &lt; MaxDate&#xA;)&#xA;INSERT INTO dw.DimDate (&#xA;    DateKey,&#xA;    FullDate,&#xA;    CalendarYear,&#xA;    CalendarQuarter,&#xA;    CalendarMonth,&#xA;    DayOfMonth,&#xA;    IsoDayOfWeek,&#xA;    IsWeekend&#xA;)&#xA;SELECT&#xA;    YEAR(c.FullDate) * 10000&#xA;        + MONTH(c.FullDate) * 100&#xA;        + DAY(c.FullDate),&#xA;&#xA;    c.FullDate,&#xA;    YEAR(c.FullDate),&#xA;    DATEPART(QUARTER, c.FullDate),&#xA;    MONTH(c.FullDate),&#xA;    DAY(c.FullDate),&#xA;&#xA;    ((DATEDIFF(DAY, '19000101',&#xA;        c.FullDate) % 7 + 7) % 7) + 1,&#xA;&#xA;    CASE&#xA;        WHEN ((DATEDIFF(DAY, '19000101',&#xA;            c.FullDate) % 7 + 7) % 7) + 1&#xA;             IN (6, 7)&#xA;        THEN 1&#xA;        ELSE 0&#xA;    END&#xA;&#xA;FROM Calendar AS c&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.DimDate AS d&#xA;    WHERE d.FullDate = c.FullDate&#xA;)&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_DimEnergySource"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{116B4EB1-1B9B-47B2-8CF8-3FA3345E5474}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_DimEnergySource"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;INSERT INTO dw.DimEnergySource (&#xA;    EnergySourceKey,&#xA;    SourceCode,&#xA;    SourceName,&#xA;    IsRenewable&#xA;)&#xA;SELECT&#xA;    s.EnergySourceKey,&#xA;    s.SourceCode,&#xA;    s.SourceName,&#xA;    s.IsRenewable&#xA;FROM (&#xA;    VALUES&#xA;        (1, 'HYDRO', N'Hydroelectric', 1),&#xA;        (2, 'WIND', N'Wind', 1),&#xA;        (3, 'OTHER', N'Other Renewables', 1),&#xA;        (4, 'SOLAR', N'Solar', 1),&#xA;        (5, 'THERMAL', N'Thermal', 0)&#xA;) AS s (&#xA;    EnergySourceKey,&#xA;    SourceCode,&#xA;    SourceName,&#xA;    IsRenewable&#xA;)&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.DimEnergySource AS d&#xA;    WHERE d.EnergySourceKey =&#xA;        s.EnergySourceKey&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Validate_Warehouse"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A34CEFEF-D713-4CB8-B390-19E09E3B67B1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Validate_Warehouse"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{62393909-96F6-4C30-B394-48E2E6742C03}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;&#xA;DECLARE @ExpectedDemand BIGINT;&#xA;DECLARE @ExpectedGeneration BIGINT;&#xA;DECLARE @ActualDemand BIGINT;&#xA;DECLARE @ActualGeneration BIGINT;&#xA;&#xA;-- 1. Expected unique Demand hours&#xA;SELECT @ExpectedDemand = COUNT_BIG(*)&#xA;FROM (&#xA;    SELECT HourUTC&#xA;    FROM wrk.DemandClean&#xA;    GROUP BY HourUTC&#xA;    HAVING COUNT_BIG(*) = 1&#xA;) AS D;&#xA;&#xA;-- 2. Expected Generation rows&#xA;SELECT @ExpectedGeneration = COUNT_BIG(*) * 5&#xA;FROM (&#xA;    SELECT HourUTC&#xA;    FROM wrk.GenerationClean&#xA;    GROUP BY HourUTC&#xA;    HAVING COUNT_BIG(*) = 1&#xA;) AS G;&#xA;&#xA;-- 3. Actual Warehouse counts&#xA;SELECT @ActualDemand = COUNT_BIG(*)&#xA;FROM dw.FactDemandHourly;&#xA;&#xA;SELECT @ActualGeneration = COUNT_BIG(*)&#xA;FROM dw.FactGenerationBySource;&#xA;&#xA;-- 4. Demand validation&#xA;IF @ActualDemand &lt;&gt; @ExpectedDemand&#xA;    THROW 51010,&#xA;        'Demand Fact row count mismatch.',&#xA;        1;&#xA;&#xA;-- 5. Generation validation&#xA;IF @ActualGeneration &lt;&gt; @ExpectedGeneration&#xA;    THROW 51011,&#xA;        'Generation Fact row count mismatch.',&#xA;        1;&#xA;&#xA;-- 6. Check five sources per hour&#xA;IF EXISTS (&#xA;    SELECT HourUTC&#xA;    FROM dw.FactGenerationBySource&#xA;    GROUP BY HourUTC&#xA;    HAVING COUNT_BIG(*) &lt;&gt; 5&#xA;        OR COUNT(DISTINCT EnergySourceKey) &lt;&gt; 5&#xA;)&#xA;    THROW 51012,&#xA;        'Incomplete generation source groups.',&#xA;        1;&#xA;&#xA;-- 7. Compare generation totals&#xA;IF EXISTS (&#xA;    SELECT f.SourceStageRowID&#xA;    FROM dw.FactGenerationBySource AS f&#xA;    INNER JOIN wrk.GenerationClean AS g&#xA;        ON f.SourceStageRowID = g.StageRowID&#xA;    GROUP BY f.SourceStageRowID, g.TotalMW&#xA;    HAVING ABS(SUM(f.GenerationMW) - g.TotalMW) &gt; 1&#xA;)&#xA;    THROW 51013,&#xA;        'Generation total mismatch.',&#xA;        1;&#xA;&#xA;PRINT 'Warehouse validation completed successfully.';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
