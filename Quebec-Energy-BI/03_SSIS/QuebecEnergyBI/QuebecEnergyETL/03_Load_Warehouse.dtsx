                  name="Lookup Input">
                  <inputColumns>
                    <inputColumn
                      refId="Package\DFT_Load_FactGeneration\Lookup.Inputs[Lookup Input].Columns[SourceCode]"
                      cachedDataType="wstr"
                      cachedLength="255"
                      cachedName="SourceCode"
                      lineageId="Package\DFT_Load_FactGeneration\Unpivot.Outputs[Unpivot Output].Columns[SourceCode]">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the column in the reference table that a column joins."
                          name="JoinToReferenceColumn">SourceCode</property>
                        <property
