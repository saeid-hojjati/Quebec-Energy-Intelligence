                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">;WITH DemandChecked AS (
    SELECT
        StageRowID,
        LocalHour,
        HourUTC,
        DemandMW,
        COUNT(*) OVER (
            PARTITION BY HourUTC
        ) AS HourCount
    FROM wrk.DemandClean
)
SELECT
    d.DateKey,
    c.HourUTC,
    c.LocalHour,
    c.DemandMW,
    c.StageRowID AS SourceStageRowID
FROM DemandChecked AS c
INNER JOIN dw.DimDate AS d
    ON d.FullDate = CAST(c.LocalHour AS DATE)
WHERE c.HourCount = 1;</property>
