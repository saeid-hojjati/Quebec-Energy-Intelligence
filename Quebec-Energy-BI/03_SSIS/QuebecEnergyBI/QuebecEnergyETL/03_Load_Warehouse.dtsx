                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH GenerationChecked AS (
    SELECT
        StageRowID,
        LocalHour,
        HourUTC,
        HydroelectricMW,
        WindMW,
        OtherRenewablesMW,
        SolarMW,
        ThermalMW,
        COUNT(*) OVER (
            PARTITION BY HourUTC
        ) AS DuplicateCount
    FROM wrk.GenerationClean
)
SELECT
    d.DateKey,
    g.HourUTC,
    g.LocalHour,
    g.StageRowID AS SourceStageRowID,
    g.HydroelectricMW,
    g.WindMW,
    g.OtherRenewablesMW,
    g.SolarMW,
    g.ThermalMW
FROM GenerationChecked AS g
INNER JOIN dw.DimDate AS d
    ON d.FullDate = CAST(g.LocalHour AS DATE)
WHERE g.DuplicateCount = 1;</property>
